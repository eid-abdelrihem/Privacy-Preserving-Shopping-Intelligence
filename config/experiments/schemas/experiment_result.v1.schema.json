{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-preserving-shopping-intelligence.local/experiment_result_v1.schema.json",
  "title": "ExperimentResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "run_id",
    "attempt",
    "state",
    "regime",
    "tasks",
    "training_cohort",
    "evaluation_cohorts",
    "seed",
    "config_ref",
    "compatibility",
    "git_sha",
    "environment_lock_ref",
    "initialization",
    "metrics",
    "artifacts",
    "system_measurements"
  ],
  "properties": {
    "schema": { "const": "experiment_result_v1" },
    "version": { "const": "1" },
    "run_id": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["PLANNED", "RUNNING", "INTERRUPTED", "SUCCEEDED", "FAILED", "CANCELLED"]
    },
    "regime": { "type": "string" },
    "tasks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "training_cohort": { "type": "string" },
    "evaluation_cohorts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "seed": { "type": "integer" },
    "config_ref": { "type": "object" },
    "compatibility": { "type": "object" },
    "git_sha": { "type": "string", "minLength": 1 },
    "environment_lock_ref": { "type": "object" },
    "initialization": { "type": "object" },
    "started_at_utc": { "type": "string" },
    "ended_at_utc": { "type": "string" },
    "resume_count": { "type": "integer", "minimum": 0 },
    "checkpoint_ref": { "type": "object" },
    "metrics": { "type": "array", "items": { "type": "object" } },
    "federated_metadata": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "system_measurements": { "type": "object" },
    "failure": { "type": "object" }
  }
}
