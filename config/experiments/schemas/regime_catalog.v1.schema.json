{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-preserving-shopping-intelligence.local/schemas/regime_catalog.v1.schema.json",
  "title": "Regime Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "regimes"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "regime_catalog_v1"
    },
    "version": {
      "type": "string",
      "const": "1"
    },
    "regimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R1", "R2A", "R2B", "R3", "R4", "R5"],
      "properties": {
        "R1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "CENTRALIZED" }
          }
        },
        "R2A": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "FEDAVG" }
          }
        },
        "R2B": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "FEDADAM" }
          }
        },
        "R3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "PERSONALIZED_FL" }
          }
        },
        "R4": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "STRICT_LOCAL" }
          }
        },
        "R5": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "orchestration_type"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "orchestration_type": { "type": "string", "const": "LOCAL_ADAPTATION" }
          }
        }
      }
    }
  }
}
