{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-preserving-shopping-intelligence.local/hashing_config_v1.schema.json",
  "title": "HashingConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "config_id",
    "profile",
    "identity_contract",
    "serialization",
    "algorithm",
    "bucket_count",
    "reserved_indices",
    "reserved_semantics",
    "residual_embedding_dim",
    "config_sha256"
  ],
  "properties": {
    "schema": { "const": "hashing_config_v1" },
    "version": { "const": "1" },
    "config_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile": {
      "enum": ["CONFORMANCE_ONLY", "MODEL_DEFAULT"]
    },
    "identity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "field", "parser"],
      "properties": {
        "schema": { "const": "CanonicalEvent/v1" },
        "field": { "const": "item_id" },
        "parser": { "const": "source_entity_raw_v1" }
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "length_unit", "unicode_normalization", "case_normalization"],
      "properties": {
        "id": { "const": "lp_u32be_utf8_namespace_id_v1" },
        "length_unit": { "const": "BYTE" },
        "unicode_normalization": { "const": "NONE" },
        "case_normalization": { "const": "NONE" }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_version",
        "digest_bits",
        "digest_interpretation",
        "reference_library",
        "reference_library_version",
        "backend_version",
        "seed_uint64"
      ],
      "properties": {
        "id": { "const": "XXH64" },
        "contract_version": { "const": "1" },
        "digest_bits": { "const": 64 },
        "digest_interpretation": { "const": "UNSIGNED_INTEGER" },
        "reference_library": { "const": "python-xxhash" },
        "reference_library_version": { "const": "4.0.1" },
        "backend_version": { "const": "0.8.3" },
        "seed_uint64": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "bucket_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "reserved_indices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PAD", "OOV", "NULL"],
      "properties": {
        "PAD": { "type": "integer", "minimum": 0 },
        "OOV": { "type": "integer", "minimum": 0 },
        "NULL": { "type": "integer", "minimum": 0 }
      }
    },
    "reserved_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PAD", "OOV", "NULL"],
      "properties": {
        "PAD": { "const": "MASKED_POSITION_ONLY" },
        "OOV": { "const": "EXPLICIT_SENTINEL_ONLY" },
        "NULL": { "const": "EXPLICIT_NULL_ONLY" }
      }
    },
    "residual_embedding_dim": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
